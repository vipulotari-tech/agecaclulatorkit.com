/sitemap.xml /sitemap-index.xml 301

# 2) Trailing slash enforcement (Astro trailingSlash: always)
# Redirect non-trailing directory requests to trailing version for clean canonicals
/about /about/ 301
/contact /contact/ 301
/faq /faq/ 301
/how-it-works /how-it-works/ 301
/birthday-calculator /birthday-calculator/ 301
/date-difference /date-difference/ 301
/privacy-policy /privacy-policy/ 301
/terms /terms/ 301
/disclaimer /disclaimer/ 301

