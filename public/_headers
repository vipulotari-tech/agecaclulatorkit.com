https://agecalculatorkit.pages.dev/*
  X-Robots-Tag: noindex

# Main domain — ensure not blocked, add security headers
https://agecalculatorkit.com/*
  X-Robots-Tag: all

# Cache sitemaps and robots short (so updates propagate quickly)
/sitemap*.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: text/plain; charset=utf-8

# Favicon / manifest cache long
/favicon.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400

