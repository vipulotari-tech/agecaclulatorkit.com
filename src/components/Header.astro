---
import LanguageSelector from "./LanguageSelector.astro";
import { getTranslations, localizePath, stripLocale } from "../i18n/utils";
import { getLocaleFromUrl } from "../i18n/utils";

interface Props { locale?: string; }
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const pathname = Astro.url.pathname;
const strippedPath = stripLocale(pathname);

// Normalize isActive to compare stripped paths
const isActive = (href: string) => {
  // href is like "/" or "/birthday-calculator/"
  // check strippedPath starts with href
  if (href === "/") return strippedPath === "/";
  return strippedPath.startsWith(href);
};

const locHref = (path: string) => localizePath(path, locale);
---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-[64px] items-center justify-between gap-2 sm:gap-4">
      <!-- Logo -->
      <a href={locHref("/")} class="flex items-center gap-2 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 rounded-[6px]" aria-label="Age Calculator - Home">
        <div class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-ink text-white">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4" /><path d="M8 2v4" /><path d="M3 10h18" />
            <path d="M8 14h.01" /><path d="M12 14h.01" /><path d="M16 14h.01" />
            <path d="M8 18h.01" /><path d="M12 18h.01" /><path d="M16 18h.01" />
          </svg>
        </div>
        <span class="text-[15px] sm:text-[16px] font-semibold tracking-[-0.3px] text-ink">{t.site.name}</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
        <a href={locHref("/")} class={`rounded-full px-3 py-1.5 text-sm transition ${strippedPath==="/" ? "bg-ink text-white font-medium" : "text-body hover:text-ink hover:bg-canvas-soft"}`}>{t.nav.ageCalculator}</a>
        <a href={locHref("/birthday-calculator/")} class={`rounded-full px-3 py-1.5 text-sm transition ${isActive("/birthday-calculator/") ? "bg-ink text-white font-medium" : "text-body hover:text-ink hover:bg-canvas-soft"}`}>{t.nav.birthday}</a>
        <a href={locHref("/date-difference/")} class={`rounded-full px-3 py-1.5 text-sm transition ${isActive("/date-difference/") ? "bg-ink text-white font-medium" : "text-body hover:text-ink hover:bg-canvas-soft"}`}>{t.nav.dateDifference}</a>
        <a href={locHref("/how-it-works/")} class={`rounded-full px-3 py-1.5 text-sm transition ${isActive("/how-it-works/") ? "bg-ink text-white font-medium" : "text-body hover:text-ink hover:bg-canvas-soft"}`}>{t.nav.howItWorks}</a>
        <a href={locHref("/faq/")} class={`rounded-full px-3 py-1.5 text-sm transition ${isActive("/faq/") ? "bg-ink text-white font-medium" : "text-body hover:text-ink hover:bg-canvas-soft"}`}>{t.nav.faq}</a>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Language Selector — desktop -->
        <div class="hidden sm:block">
          <LanguageSelector />
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-[6px] border border-hairline bg-white text-ink lg:hidden hover:bg-canvas-soft transition"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.nav.openMenu}
        >
          <svg class="menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="close-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-hairline -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 py-4 bg-white">
      <nav class="flex flex-col gap-1" aria-label="Mobile primary">
        <a href={locHref("/")} class={`rounded-[6px] px-3 py-2.5 text-sm font-medium transition ${strippedPath==="/" ? "bg-ink text-white" : "text-body hover:bg-canvas-soft hover:text-ink"}`}>{t.nav.ageCalculator}</a>
        <a href={locHref("/birthday-calculator/")} class={`rounded-[6px] px-3 py-2.5 text-sm font-medium transition ${isActive("/birthday-calculator/") ? "bg-ink text-white" : "text-body hover:bg-canvas-soft hover:text-ink"}`}>{t.nav.birthdayCalculator}</a>
        <a href={locHref("/date-difference/")} class={`rounded-[6px] px-3 py-2.5 text-sm font-medium transition ${isActive("/date-difference/") ? "bg-ink text-white" : "text-body hover:bg-canvas-soft hover:text-ink"}`}>{t.nav.dateDifferenceCalculator}</a>
        <a href={locHref("/how-it-works/")} class={`rounded-[6px] px-3 py-2.5 text-sm font-medium transition ${isActive("/how-it-works/") ? "bg-ink text-white" : "text-body hover:bg-canvas-soft hover:text-ink"}`}>{t.nav.howItWorks}</a>
        <a href={locHref("/faq/")} class={`rounded-[6px] px-3 py-2.5 text-sm font-medium transition ${isActive("/faq/") ? "bg-ink text-white" : "text-body hover:bg-canvas-soft hover:text-ink"}`}>{t.nav.faq}</a>
        <div class="mt-3 flex sm:hidden">
          <LanguageSelector />
        </div>
        <div class="mt-3 h-px bg-hairline"></div>
        <div class="grid grid-cols-2 gap-2 pt-3 text-xs">
          <a href={locHref("/about/")} class="text-mute hover:text-ink">{t.nav.about}</a>
          <a href={locHref("/contact/")} class="text-mute hover:text-ink">{t.nav.contact}</a>
          <a href={locHref("/privacy-policy/")} class="text-mute hover:text-ink">{t.nav.privacy}</a>
          <a href={locHref("/terms/")} class="text-mute hover:text-ink">{t.nav.terms}</a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const t = btn.getAttribute('aria-label');
      // toggle
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      btn.querySelector('.menu-icon')?.classList.toggle('hidden');
      btn.querySelector('.close-icon')?.classList.toggle('hidden');
      // update label generically
      if (expanded) {
        // closing
        const openLabel = btn.dataset.openLabel || 'Open menu';
        btn.setAttribute('aria-label', openLabel);
      } else {
        const closeLabel = btn.dataset.closeLabel || 'Close menu';
        btn.setAttribute('aria-label', closeLabel);
      }
    });
  }
</script>
