---
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-white">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-[6px] bg-ink text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4" /><path d="M8 2v4" /><path d="M3 10h18" />
            </svg>
          </div>
          <span class="text-[15px] font-semibold tracking-[-0.3px] text-ink">Age Calculator</span>
        </a>
        <p class="mt-3 max-w-[320px] text-sm leading-5 text-body">
          A fast, accurate and private age calculator. Calculate your exact age in years, months and days instantly — with birthday countdown and date difference tools.
        </p>
        <p class="mt-3 text-xs leading-4 text-mute">
          Contact: <a href="mailto:hello@agecalculatorkit.com" class="text-link hover:text-link-deep underline underline-offset-2">hello@agecalculatorkit.com</a> • <a href="mailto:vipulotari1718@gmail.com" class="text-link hover:text-link-deep underline underline-offset-2">vipulotari1718@gmail.com</a> • <a href="/contact/" class="text-link hover:text-link-deep underline underline-offset-2">Contact page</a>
        </p>
        <p class="mt-3 text-xs text-mute">&copy; {year} Age Calculator (agecalculatorkit.com). All rights reserved.</p>
      </div>
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-mute">Tools</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/" class="text-body hover:text-ink transition">Age Calculator</a></li>
          <li><a href="/birthday-calculator/" class="text-body hover:text-ink transition">Birthday Calculator</a></li>
          <li><a href="/date-difference/" class="text-body hover:text-ink transition">Date Difference Calculator</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-mute">Learn</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/how-it-works/" class="text-body hover:text-ink transition">How It Works</a></li>
          <li><a href="/faq/" class="text-body hover:text-ink transition">FAQ</a></li>
          <li><a href="/about/" class="text-body hover:text-ink transition">About</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-mute">Legal</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/privacy-policy/" class="text-body hover:text-ink transition">Privacy</a></li>
          <li><a href="/terms/" class="text-body hover:text-ink transition">Terms</a></li>
          <li><a href="/disclaimer/" class="text-body hover:text-ink transition">Disclaimer</a></li>
          <li><a href="/contact/" class="text-body hover:text-ink transition">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs leading-4 text-mute max-w-[640px]">
        Age calculations are performed locally in your browser. We do not store your dates. For important legal or official use, please verify independently. See <a href="/privacy-policy/" class="underline underline-offset-2 hover:text-ink">privacy policy</a>, <a href="/terms/" class="underline underline-offset-2 hover:text-ink">terms</a> and <a href="/disclaimer/" class="underline underline-offset-2 hover:text-ink">disclaimer</a>.
      </p>
      <div class="flex items-center gap-2 text-xs text-mute">
        <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span> All calculations run locally
      </div>
    </div>
  </div>
</footer>
