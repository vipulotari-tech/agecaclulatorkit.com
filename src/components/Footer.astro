---
import { getTranslations, localizePath } from "../i18n/utils";
import { getLocaleFromUrl } from "../i18n/utils";
interface Props { locale?: string; }
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const year = new Date().getFullYear();
const loc = (p: string) => localizePath(p, locale);
---

<footer class="border-t border-hairline bg-white" dir={t.site.name ? undefined : undefined}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:grid-cols-5">
      <!-- Brand -->
      <div class="col-span-2 lg:col-span-2">
        <a href={loc("/")} class="inline-flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-[6px] bg-ink text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4" /><path d="M8 2v4" /><path d="M3 10h18" />
            </svg>
          </div>
          <span class="text-[15px] font-semibold tracking-[-0.3px] text-ink">{t.site.name}</span>
        </a>
        <p class="mt-3 max-w-[320px] text-sm leading-5 text-body">
          {t.footer.tagline}
        </p>
        <p class="mt-4 text-xs text-mute">© {year} {t.site.name}. {t.footer.rights}</p>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-mute">{t.footer.tools}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={loc("/")} class="text-body hover:text-ink transition">{t.nav.ageCalculator}</a></li>
          <li><a href={loc("/birthday-calculator/")} class="text-body hover:text-ink transition">{t.nav.birthdayCalculator}</a></li>
          <li><a href={loc("/date-difference/")} class="text-body hover:text-ink transition">{t.nav.dateDifferenceCalculator}</a></li>
        </ul>
      </div>

      <!-- Learn -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-mute">{t.footer.learn}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={loc("/how-it-works/")} class="text-body hover:text-ink transition">{t.nav.howItWorks}</a></li>
          <li><a href={loc("/faq/")} class="text-body hover:text-ink transition">{t.nav.faq}</a></li>
          <li><a href={loc("/about/")} class="text-body hover:text-ink transition">{t.nav.about}</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-mute">{t.footer.legal}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={loc("/privacy-policy/")} class="text-body hover:text-ink transition">{t.nav.privacy}</a></li>
          <li><a href={loc("/terms/")} class="text-body hover:text-ink transition">{t.nav.terms}</a></li>
          <li><a href={loc("/disclaimer/")} class="text-body hover:text-ink transition">{t.nav.disclaimer}</a></li>
          <li><a href={loc("/contact/")} class="text-body hover:text-ink transition">{t.nav.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs leading-4 text-mute max-w-[640px]">
        {t.footer.localNote}
      </p>
      <div class="flex items-center gap-2 text-xs text-mute">
        <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span> {t.footer.localBadge}
      </div>
    </div>
  </div>
</footer>
