<div id="cookie-consent" role="dialog" aria-modal="false" aria-labelledby="cookie-title" aria-describedby="cookie-desc" class="hidden fixed inset-x-0 bottom-0 z-50 mx-auto max-w-[880px] p-4 sm:p-6">
  <div class="rounded-[16px] border border-hairline bg-white shadow-card p-4 sm:p-5">
    <div class="flex flex-col sm:flex-row gap-4">
      <div class="flex-1">
        <h2 id="cookie-title" class="text-sm font-semibold text-ink">Cookies &amp; privacy</h2>
        <p id="cookie-desc" class="mt-1 text-sm leading-5 text-body">
          We use <strong class="font-medium text-ink">Google Analytics 4</strong> and <strong class="font-medium text-ink">Google Fonts</strong> to understand visits and display the site. Analytics cookies are set only if you accept. See our <a href="/privacy-policy/" class="text-link hover:text-link-deep underline underline-offset-4">privacy policy</a> for details.
          <span class="block mt-1 text-xs text-mute">Calculations themselves run locally and never leave your browser.</span>
        </p>
      </div>
      <div class="flex sm:flex-col gap-2 shrink-0 sm:w-[220px]">
        <button id="cookie-accept" type="button" class="inline-flex h-11 flex-1 sm:flex-none items-center justify-center rounded-full bg-ink px-5 text-sm font-medium text-white hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 transition">Accept analytics</button>
        <button id="cookie-decline" type="button" class="inline-flex h-11 flex-1 sm:flex-none items-center justify-center rounded-full border border-hairline bg-white px-5 text-sm font-medium text-ink hover:bg-canvas-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 transition">Decline</button>
      </div>
    </div>
    <p class="mt-3 text-[11px] leading-4 text-mute">You can change your choice anytime: clear this site’s storage or use <a href="/privacy-policy/" class="underline underline-offset-2">privacy controls</a>. No ads are loaded yet — ad storage stays denied until future AdSense is enabled and you consent.</p>
  </div>
</div>

<script is:inline>
  (function(){
    const KEY = 'cookie-consent-v1';
    const banner = document.getElementById('cookie-consent');
    const accept = document.getElementById('cookie-accept');
    const decline = document.getElementById('cookie-decline');
    if (!banner || !accept || !decline) return;

    function applyConsent(granted){
      try {
        // gtag may not be loaded yet; queue via dataLayer
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            analytics_storage: granted ? 'granted' : 'denied',
            // keep ad_storage denied until AdSense is actually loaded in future
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
          if (granted) {
            window.gtag('event', 'consent_update', { analytics_storage: granted ? 'granted' : 'denied' });
          }
        } else {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(['consent', 'update', { analytics_storage: granted ? 'granted' : 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' }]);
        }
      } catch {}
    }

    function hide(){
      banner.classList.add('hidden');
      banner.setAttribute('aria-hidden', 'true');
    }
    function show(){
      banner.classList.remove('hidden');
      banner.removeAttribute('aria-hidden');
      // focus first button for accessibility but not stealing from main content aggressively
      accept.focus({ preventScroll: true });
    }

    let stored = null;
    try { stored = localStorage.getItem(KEY); } catch {}

    if (stored === 'granted') {
      applyConsent(true);
    } else if (stored === 'denied') {
      applyConsent(false);
    } else {
      // no choice yet: show after short delay to avoid CLS and allow page to render
      setTimeout(show, 800);
    }

    accept.addEventListener('click', function(){
      try { localStorage.setItem(KEY, 'granted'); } catch {}
      applyConsent(true);
      hide();
    });
    decline.addEventListener('click', function(){
      try { localStorage.setItem(KEY, 'denied'); } catch {}
      applyConsent(false);
      hide();
    });

    // allow closing with Escape without choosing (remains denied by default)
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && !banner.classList.contains('hidden')) {
        hide();
      }
    });
  })();
</script>

<style>
  #cookie-consent.hidden { display: none !important; }
  @media (prefers-reduced-motion: reduce) {
    #cookie-consent { transition: none !important; }
  }
</style>
