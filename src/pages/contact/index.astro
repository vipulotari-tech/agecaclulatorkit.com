---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const title = "Contact — Get in Touch";
const description = "Contact Age Calculator. Send feedback, report an issue or ask a question. We welcome suggestions to improve accuracy and accessibility.";
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-hairline bg-white">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumbs items={[{label:"Home", href:"/"}, {label:"Contact"}]} />
      <div class="mx-auto max-w-[720px] mt-6">
        <h1 class="text-[30px] sm:text-[36px] font-semibold tracking-[-1.2px] leading-none text-ink">Contact</h1>
        <p class="mt-3 text-[16px] leading-6 text-body">We’d love to hear from you — feedback, bug reports or ideas.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="mx-auto max-w-[720px] grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-[16px] border border-hairline bg-white p-6 sm:p-8 shadow-card">
        <h2 class="text-sm font-semibold text-ink">Send a message</h2>
        <p class="mt-1 text-xs text-mute">This form is a placeholder. Configure a real endpoint before deployment.</p>

        <form class="mt-6 space-y-4" onsubmit="event.preventDefault(); alert('Configure form handling before deployment. See contact page code comments.');">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="c-name" class="text-xs font-medium text-body">Name</label>
              <input id="c-name" autocomplete="name" required class="h-11 w-full rounded-[8px] border border-hairline bg-white px-3 text-sm text-ink placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/10" placeholder="Your name" />
            </div>
            <div class="space-y-1.5">
              <label for="c-email" class="text-xs font-medium text-body">Email</label>
              <input id="c-email" type="email" autocomplete="email" required class="h-11 w-full rounded-[8px] border border-hairline bg-white px-3 text-sm text-ink placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/10" placeholder="you@example.com" />
            </div>
          </div>
          <div class="space-y-1.5">
            <label for="c-subject" class="text-xs font-medium text-body">Subject</label>
            <input id="c-subject" required class="h-11 w-full rounded-[8px] border border-hairline bg-white px-3 text-sm text-ink placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/10" placeholder="How can we help?" />
          </div>
          <div class="space-y-1.5">
            <label for="c-message" class="text-xs font-medium text-body">Message</label>
            <textarea id="c-message" rows="5" required class="w-full rounded-[8px] border border-hairline bg-white px-3 py-2.5 text-sm text-ink placeholder:text-mute focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink/10" placeholder="Describe your feedback or question..."></textarea>
          </div>

          <div class="rounded-[10px] bg-canvas-soft border border-hairline p-3 text-xs leading-4 text-mute">
            <strong class="text-ink">Privacy:</strong> Messages are not stored beyond what your email service handles. See <a href="/privacy-policy/" class="text-link underline underline-offset-4">Privacy Policy</a>. Do not include sensitive personal data you don’t want to share.
          </div>

          <button type="submit" class="inline-flex h-11 w-full sm:w-auto items-center justify-center rounded-full bg-ink px-6 text-sm font-medium text-white hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 transition">Send Message</button>
          <p class="text-xs text-mute">By sending, you agree we may reply via the email you provide.</p>
        </form>
      </div>

      <div class="space-y-6">
        <div class="rounded-[16px] border border-hairline bg-white p-6">
          <h3 class="text-sm font-semibold text-ink">Other ways</h3>
          <dl class="mt-3 space-y-3 text-sm">
            <div>
              <dt class="text-xs font-mono uppercase tracking-widest text-mute">Email</dt>
              <dd class="mt-1">
                <a href="mailto:hello@agecalculatorkit.com" class="text-link hover:text-link-deep underline underline-offset-4">hello@agecalculatorkit.com</a>
                <p class="text-xs text-mute mt-1">Replace with your real address before launch. This is a placeholder that’s easy to configure.</p>
              </dd>
            </div>
            <div>
              <dt class="text-xs font-mono uppercase tracking-widest text-mute">Response time</dt>
              <dd class="text-body mt-1">We aim to reply within 2–3 business days.</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-[16px] border border-hairline bg-canvas-soft p-6">
          <h3 class="text-sm font-semibold text-ink">Before you write</h3>
          <ul class="mt-2 list-disc pl-5 space-y-1 text-xs leading-5 text-body">
            <li>Check <a href="/faq/" class="text-link underline underline-offset-4">FAQ</a> — many questions are answered there.</li>
            <li>Include dates and steps to reproduce any bug.</li>
            <li>No need to share full birth dates if you prefer not to.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
