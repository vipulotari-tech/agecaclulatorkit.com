---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const title = "Contact — Get in Touch";
const description = "Contact Age Calculator. Send feedback, report an issue or ask a question. We welcome suggestions to improve accuracy and accessibility.";
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-hairline bg-white">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumbs items={[{label:"Home", href:"/"}, {label:"Contact"}]} />
      <div class="mx-auto max-w-[720px] mt-6">
        <h1 class="text-[30px] sm:text-[36px] font-semibold tracking-[-1.2px] leading-none text-ink">Contact</h1>
        <p class="mt-3 text-[16px] leading-6 text-body">Get in touch with Age Calculator.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="mx-auto max-w-[720px] space-y-6">
      <article class="rounded-[16px] border border-hairline bg-white p-6 sm:p-8">
        <h2 class="text-lg font-semibold tracking-tight text-ink">How to reach us</h2>
        <p class="mt-3 text-sm leading-6 text-body">
          <a href="/" class="text-link underline underline-offset-4">Age Calculator</a> — calculations run locally in your browser.
        </p>
        <p class="mt-3 text-sm leading-6 text-body">
          We welcome your feedback. Whether you found a bug, have a suggestion for improving accuracy, or just want to say hello — we'd love to hear from you.
        </p>

        <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">What to include</h2>
        <ul class="mt-3 list-disc pl-5 space-y-1.5 text-sm leading-6 text-body">
          <li>The URL where you encountered the issue</li>
          <li>The dates you entered (if applicable)</li>
          <li>Your browser and device type</li>
          <li>Steps to reproduce the problem</li>
          <li>Screenshots if relevant</li>
        </ul>

        <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">Response time</h2>
        <p class="mt-3 text-sm leading-6 text-body">We aim to respond within 48 hours. For urgent issues, please include "urgent" in your message subject.</p>

        <div class="mt-8 flex flex-wrap gap-2">
          <a href="/" class="inline-flex items-center rounded-full bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-black transition">Try the calculator</a>
          <a href="/faq/" class="inline-flex items-center rounded-full border border-hairline bg-white px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft transition">Read FAQ</a>
          <a href="/how-it-works/" class="inline-flex items-center rounded-full border border-hairline bg-white px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft transition">How it works</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
