---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgeDifferenceCalculator from "../../components/AgeDifferenceCalculator.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const title = "Age Difference Calculator – Exact Age Gap Between Two People";
const description = "Compare two dates of birth and calculate the exact age gap in years, months and days. See who is older, total days apart and each person's age today.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": "https://agecalculatorkit.com/age-difference-calculator/",
    "isPartOf": { "@type": "WebSite", "name": "Age Calculator", "url": "https://agecalculatorkit.com/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://agecalculatorkit.com/" },
      { "@type": "ListItem", "position": 2, "name": "Age Difference Calculator", "item": "https://agecalculatorkit.com/age-difference-calculator/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I calculate the age difference between two people?", "acceptedAnswer": { "@type": "Answer", "text": "Enter both dates of birth. The calculator identifies the earlier date, returns the exact calendar gap in years, months and days, and also shows total days apart and each person's current age." } },
      { "@type": "Question", "name": "Does the age gap change over time?", "acceptedAnswer": { "@type": "Answer", "text": "The exact difference between the two birth dates is fixed. The difference between each person's completed age in whole years can appear to change during the year because their birthdays occur on different dates." } },
      { "@type": "Question", "name": "Does the order of the birth dates matter?", "acceptedAnswer": { "@type": "Answer", "text": "No. The calculator automatically identifies who is older and produces the same exact gap whichever date you enter first." } }
    ]
  }
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <section class="relative overflow-hidden border-b border-hairline bg-white">
    <div class="absolute inset-0 mesh-gradient opacity-40 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-11">
      <Breadcrumbs items={[{label:"Home", href:"/"}, {label:"Age Difference Calculator"}]} />
      <div class="mx-auto max-w-[880px] mt-6">
        <div class="inline-flex rounded-full border border-hairline bg-white/80 px-3 py-1 text-xs text-mute shadow-sm">Two birth dates • One exact gap</div>
        <h1 class="mt-4 text-[30px] sm:text-[38px] font-semibold tracking-[-1.4px] leading-none text-ink">Age Difference Calculator</h1>
        <p class="mt-3 max-w-[680px] text-[16px] leading-7 text-body">Compare two dates of birth and find the exact <strong class="font-medium text-ink">age gap in years, months and days</strong>. The calculator also tells you who is older, the total number of days apart and each person's age today.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <AgeDifferenceCalculator />

    <article class="mx-auto max-w-[880px] mt-10 rounded-[18px] border border-hairline bg-white p-6 sm:p-8 shadow-card">
      <h2 class="text-xl font-semibold tracking-tight text-ink">What does an age difference calculator measure?</h2>
      <p class="mt-3 text-sm leading-6 text-body">The exact age gap is the calendar distance between two complete dates of birth. That distance is fixed. If two people were born 3 years, 4 months and 12 days apart, that birth-date gap does not change as they get older.</p>
      <p class="mt-3 text-sm leading-6 text-body">What can change during the year is the difference between their <em>completed ages</em> in whole years. If one birthday happens months before the other, one person may temporarily appear an extra year older until the second birthday occurs. This calculator shows the fixed birth-date gap and each person's current calendar age so the distinction is clear.</p>

      <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">How the exact age gap is calculated</h2>
      <ol class="mt-3 list-decimal pl-5 space-y-2 text-sm leading-6 text-body">
        <li>The earlier birth date is used as the start date and the later birth date as the end date.</li>
        <li>The calculator counts the largest completed calendar years first.</li>
        <li>It then counts completed calendar months. Month-end dates clamp to the last valid day in shorter months.</li>
        <li>The remaining whole calendar days are counted at UTC midnight, avoiding daylight-saving shifts.</li>
      </ol>
      <p class="mt-3 text-sm leading-6 text-body">The same shared calendar engine powers the <a href="/" class="text-link underline underline-offset-4">Age Calculator</a> and <a href="/date-difference/" class="text-link underline underline-offset-4">Date Difference Calculator</a>, so the tools use the same leap-year and month-end rules.</p>

      <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">Useful ways to compare two ages</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-[12px] border border-hairline bg-canvas-soft p-4"><h3 class="text-sm font-semibold text-ink">Exact calendar gap</h3><p class="mt-1 text-xs leading-5 text-body">Years, months and days between the two birth dates.</p></div>
        <div class="rounded-[12px] border border-hairline bg-canvas-soft p-4"><h3 class="text-sm font-semibold text-ink">Total days apart</h3><p class="mt-1 text-xs leading-5 text-body">An unambiguous elapsed-day count between the birthdays.</p></div>
        <div class="rounded-[12px] border border-hairline bg-canvas-soft p-4"><h3 class="text-sm font-semibold text-ink">Ages today</h3><p class="mt-1 text-xs leading-5 text-body">Each person's current age using the same calendar rules.</p></div>
      </div>

      <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">Common uses</h2>
      <p class="mt-3 text-sm leading-6 text-body">People use an age difference calculator for sibling spacing, family records, genealogy checks, comparing friends or partners, and verifying the gap between historical dates of birth. The result is a neutral calendar measurement; it does not make legal, medical or relationship judgments.</p>

      <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">Privacy</h2>
      <p class="mt-3 text-sm leading-6 text-body">The calculation runs in your browser. Recent dates may be remembered in your browser's localStorage so you can return to the form. They are not stored in a calculator database on our server. See the <a href="/privacy-policy/" class="text-link underline underline-offset-4">privacy policy</a> for the exact storage and analytics details.</p>

      <h2 class="mt-8 text-lg font-semibold tracking-tight text-ink">Frequently asked questions</h2>
      <div class="mt-4 space-y-3 text-sm leading-6 text-body">
        <div class="rounded-[12px] border border-hairline bg-canvas-soft p-4"><h3 class="font-semibold text-ink">Does the order of the dates matter?</h3><p class="mt-1">No. The tool automatically identifies the earlier date and labels which person is older.</p></div>
        <div class="rounded-[12px] border border-hairline bg-canvas-soft p-4"><h3 class="font-semibold text-ink">What if both people have the same birthday?</h3><p class="mt-1">The exact gap is 0 years, 0 months and 0 days, and the result notes that both dates of birth are the same.</p></div>
        <div class="rounded-[12px] border border-hairline bg-canvas-soft p-4"><h3 class="font-semibold text-ink">Does it handle leap years?</h3><p class="mt-1">Yes. The shared calendar engine uses Gregorian leap-year rules and consistent February 29 handling.</p></div>
      </div>
    </article>

    <div class="mx-auto max-w-[880px] mt-8 flex flex-wrap gap-2">
      <a href="/" class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-black">Age Calculator</a>
      <a href="/date-difference/" class="rounded-full border border-hairline bg-white px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft">Date Difference</a>
      <a href="/birthday-calculator/" class="rounded-full border border-hairline bg-white px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft">Birthday Calculator</a>
    </div>
  </section>
</BaseLayout>
