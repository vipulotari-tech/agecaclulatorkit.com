---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgeCalculator from "../../components/AgeCalculator.astro";
import AdSlot from "../../components/AdSlot.astro";
import FAQ from "../../components/FAQ.astro";
import { homepageFaqs, faqAnswerPlain } from "../../data/faqs";
import { publishedLocales } from "../../i18n/config";
import { getTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return publishedLocales.filter(l => l.code !== 'en').map(l => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);

const title = t.seo.home.title;
const description = t.seo.home.description;
const homeFaqs = homepageFaqs();

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": t.site.name,
    "url": `https://agecalculatorkit.com/${locale}/`,
    "description": description,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": `https://agecalculatorkit.com/${locale}/`,
    "isPartOf": { "@type": "WebSite", "name": t.site.name, "url": "https://agecalculatorkit.com/" },
    "primaryImageOfPage": { "@type": "ImageObject", "contentUrl": "https://agecalculatorkit.com/favicon.svg" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t.common.home, "item": `https://agecalculatorkit.com/${locale}/` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": homeFaqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": faqAnswerPlain(f) }
    }))
  }
];
---

<BaseLayout title={title} description={description} locale={locale} structuredData={structuredData}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-hairline bg-white">
    <div class="absolute inset-0 mesh-gradient opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-10 sm:py-14 lg:py-16">
      <div class="mx-auto max-w-[720px] text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-white px-3 py-1 text-xs text-mute shadow-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          {t.hero.badge}
        </div>
        <h1 class="mt-5 text-[34px] sm:text-[44px] font-semibold tracking-[-1.8px] sm:tracking-[-2.4px] leading-[0.95] text-ink">
          {t.hero.title}
        </h1>
        <p class="mx-auto mt-4 max-w-[580px] text-[16px] sm:text-[18px] leading-7 text-body">
          {t.hero.subtitle}
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-2 text-xs">
          <span class="rounded-full bg-canvas-soft px-3 py-1.5 text-body border border-hairline">{t.hero.noSignup}</span>
          <span class="rounded-full bg-canvas-soft px-3 py-1.5 text-body border border-hairline">{t.hero.runsLocally}</span>
          <span class="rounded-full bg-canvas-soft px-3 py-1.5 text-body border border-hairline">{t.hero.mobileFriendly}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <AgeCalculator />

    <div class="mx-auto max-w-[880px] mt-8">
      <AdSlot height="120px" label="Advertisement — Home below calculator" />
    </div>

    <!-- Trust / Explainer -->
    <div class="mx-auto max-w-[880px] mt-10 grid gap-6 sm:grid-cols-3">
      <div class="rounded-[12px] border border-hairline bg-white p-5">
        <div class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-canvas-soft border border-hairline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#171717" stroke-width="1.8" aria-hidden="true"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-semibold text-ink">Calendar accurate</h3>
        <p class="mt-1 text-sm leading-5 text-body">Uses real month lengths and leap years. Not a simple days ÷ 365 estimate.</p>
      </div>
      <div class="rounded-[12px] border border-hairline bg-white p-5">
        <div class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-canvas-soft border border-hairline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#171717" stroke-width="1.8" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-semibold text-ink">Private by design</h3>
        <p class="mt-1 text-sm leading-5 text-body">Dates never leave your device. Nothing stored on a server.</p>
      </div>
      <div class="rounded-[12px] border border-hairline bg-white p-5">
        <div class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-canvas-soft border border-hairline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#171717" stroke-width="1.8" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-semibold text-ink">Built for everyone</h3>
        <p class="mt-1 text-sm leading-5 text-body">Keyboard accessible, responsive from small phones to ultrawide monitors.</p>
      </div>
    </div>

    <!-- Related tools -->
    <div class="mx-auto max-w-[880px] mt-10 rounded-[16px] border border-hairline bg-white p-6 sm:p-8">
      <h2 class="text-sm font-semibold text-ink">More date tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <a href={`/${locale}/birthday-calculator/`} class="group flex items-center justify-between rounded-[12px] border border-hairline bg-canvas-soft p-4 hover:bg-white hover:shadow-card transition">
          <div>
            <div class="text-sm font-medium text-ink group-hover:text-link">{t.nav.birthdayCalculator} →</div>
            <div class="text-xs text-mute mt-1">Next & previous birthdays, days remaining, weekday</div>
          </div>
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white border border-hairline">🎂</div>
        </a>
        <a href={`/${locale}/date-difference/`} class="group flex items-center justify-between rounded-[12px] border border-hairline bg-canvas-soft p-4 hover:bg-white hover:shadow-card transition">
          <div>
            <div class="text-sm font-medium text-ink group-hover:text-link">{t.nav.dateDifferenceCalculator} →</div>
            <div class="text-xs text-mute mt-1">Years, months, days between any two dates</div>
          </div>
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white border border-hairline">📅</div>
        </a>
      </div>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <a href={`/${locale}/how-it-works/`} class="text-link hover:text-link-deep hover:underline underline-offset-4">{t.nav.howItWorks}</a>
        <span class="text-hairline-strong">•</span>
        <a href={`/${locale}/faq/`} class="text-link hover:text-link-deep hover:underline underline-offset-4">{t.nav.faq}</a>
      </div>
    </div>

    <!-- SEO Content 600-800 words — simplified for localized, full English fallback -->
    <article class="mx-auto max-w-[720px] mt-12 space-y-6">
      <div class="rounded-[16px] border border-hairline bg-white p-6 sm:p-8">
        <h2 class="text-xl font-semibold tracking-tight text-ink">What Is an Age Calculator?</h2>
        <p class="mt-3 text-sm leading-6 text-body">
          An age calculator is a free online tool that determines your chronological age from your date of birth. Our online age calculator is a free age calculator and accurate age calculator that runs entirely in your browser.
        </p>
        <p class="mt-3 text-sm leading-6 text-body">
          Whether you want to calculate my age today or answer “how old am I?” the tool uses the same reliable method. <a href={`/${locale}/how-it-works/`} class="text-link underline underline-offset-4">Learn how age is calculated</a>.
        </p>
      </div>
    </article>

    <!-- Homepage FAQ -->
    <section class="mx-auto max-w-[720px] mt-8 rounded-[16px] border border-hairline bg-white p-6 sm:p-8" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-xl font-semibold tracking-tight text-ink">Frequently Asked Questions</h2>
      <p class="mt-2 text-sm text-body">Quick answers — for the full list see <a href={`/${locale}/faq/`} class="text-link underline underline-offset-4">FAQ</a>.</p>
      <div class="mt-6">
        <FAQ faqs={homeFaqs} idPrefix="home-faq" />
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={`/${locale}/faq/`} class="inline-flex items-center rounded-full bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-black transition">View all FAQ →</a>
      </div>
    </section>
  </section>
</BaseLayout>
