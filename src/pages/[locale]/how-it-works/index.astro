---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { publishedLocales } from "../../../i18n/config";
import { getTranslations, localizePath } from "../../../i18n/utils";

export function getStaticPaths() {
  return publishedLocales.filter(l => l.code !== 'en').map(l => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const title = t.seo.howItWorks.title;
const description = t.seo.howItWorks.description;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": `https://agecalculatorkit.com/${locale}/how-it-works/`,
    "isPartOf": { "@type": "WebSite", "name": t.site.name, "url": "https://agecalculatorkit.com/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t.common.home, "item": `https://agecalculatorkit.com/${locale}/` },
      { "@type": "ListItem", "position": 2, "name": t.nav.howItWorks, "item": `https://agecalculatorkit.com/${locale}/how-it-works/` }
    ]
  }
];
---

<BaseLayout title={title} description={description} locale={locale} structuredData={structuredData}>
  <section class="border-b border-hairline bg-white">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumbs items={[{label: t.common.home, href: localizePath("/", locale)}, {label: t.nav.howItWorks}]} />
      <div class="mx-auto max-w-[720px] mt-6">
        <h1 class="text-[30px] sm:text-[36px] font-semibold tracking-[-1.2px] leading-none text-ink">{title}</h1>
        <p class="mt-3 text-[16px] leading-6 text-body">{description}</p>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="mx-auto max-w-[720px] space-y-6">
      <article class="rounded-[16px] border border-hairline bg-white p-6 sm:p-8">
        <p class="text-sm leading-6 text-body">This page explains how age is calculated with exact calendar logic. See the <a href={localizePath("/", locale)} class="text-link underline underline-offset-4">{t.nav.ageCalculator}</a> for the tool itself.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href={localizePath("/", locale)} class="inline-flex items-center rounded-full bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-black transition">{t.common.tryCalculator}</a>
          <a href={localizePath("/faq/", locale)} class="inline-flex items-center rounded-full border border-hairline bg-white px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft transition">{t.nav.faq}</a>
        </div>
      </article>
      <AdSlot height="120px" label="Advertisement — How it works" />
    </div>
  </section>
</BaseLayout>
