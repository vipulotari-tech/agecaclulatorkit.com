---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page Not Found — Age Calculator";
const description = "The page you're looking for doesn't exist. Return to the age calculator or explore birthday and date difference tools.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="relative overflow-hidden border-b border-hairline bg-white">
    <div class="absolute inset-0 mesh-gradient opacity-30 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="mx-auto max-w-[720px] text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-white px-3 py-1 text-xs font-mono uppercase tracking-widest text-mute">Error 404</div>
        <h1 class="mt-4 text-[48px] sm:text-[64px] font-semibold tracking-[-2.4px] leading-none text-ink">404</h1>
        <p class="mt-2 text-lg font-medium tracking-tight text-ink">Page not found</p>
        <p class="mx-auto mt-3 max-w-[520px] text-[15px] leading-6 text-body">
          The page you're looking for doesn't exist, was moved, or the link is incorrect. All calculations still run locally — let's get you back.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/" class="inline-flex h-11 items-center justify-center rounded-full bg-ink px-6 text-sm font-medium text-white hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 transition">Go to Age Calculator</a>
          <a href="/birthday-calculator/" class="inline-flex h-11 items-center justify-center rounded-full border border-hairline bg-white px-6 text-sm font-medium text-ink hover:bg-canvas-soft transition">Birthday Calculator</a>
          <a href="/date-difference/" class="inline-flex h-11 items-center justify-center rounded-full border border-hairline bg-white px-6 text-sm font-medium text-ink hover:bg-canvas-soft transition">Date Difference</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="mx-auto max-w-[720px]">
      <div class="rounded-[16px] border border-hairline bg-white p-6 sm:p-8 shadow-card">
        <h2 class="text-sm font-semibold text-ink">Try these instead</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <a href="/" class="group rounded-[12px] border border-hairline bg-canvas-soft p-4 hover:bg-white hover:shadow-card transition">
            <div class="text-sm font-medium text-ink group-hover:text-link">Age Calculator</div>
            <div class="mt-1 text-xs leading-4 text-mute">Exact age in years, months and days with next birthday and zodiac.</div>
          </a>
          <a href="/birthday-calculator/" class="group rounded-[12px] border border-hairline bg-canvas-soft p-4 hover:bg-white hover:shadow-card transition">
            <div class="text-sm font-medium text-ink group-hover:text-link">Birthday Calculator</div>
            <div class="mt-1 text-xs leading-4 text-mute">Next birthday countdown, weekday and progress.</div>
          </a>
          <a href="/date-difference/" class="group rounded-[12px] border border-hairline bg-canvas-soft p-4 hover:bg-white hover:shadow-card transition">
            <div class="text-sm font-medium text-ink group-hover:text-link">Date Difference</div>
            <div class="mt-1 text-xs leading-4 text-mute">Years, months and days between any two dates.</div>
          </a>
          <a href="/how-it-works/" class="group rounded-[12px] border border-hairline bg-canvas-soft p-4 hover:bg-white hover:shadow-card transition">
            <div class="text-sm font-medium text-ink group-hover:text-link">How it works</div>
            <div class="mt-1 text-xs leading-4 text-mute">Calendar logic, leap years and February 29 handling.</div>
          </a>
        </div>
        <div class="mt-6 flex flex-wrap gap-2 text-xs">
          <a href="/faq/" class="text-link hover:text-link-deep hover:underline underline-offset-4">FAQ</a>
          <span class="text-hairline-strong">&bull;</span>
          <a href="/about/" class="text-link hover:text-link-deep hover:underline underline-offset-4">About</a>
          <span class="text-hairline-strong">&bull;</span>
          <a href="/contact/" class="text-link hover:text-link-deep hover:underline underline-offset-4">Contact</a>
          <span class="text-hairline-strong">&bull;</span>
          <a href="/sitemap-index.xml" class="text-link hover:text-link-deep hover:underline underline-offset-4">Sitemap</a>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-mute">
        If you followed a link on this site and landed here, please <a href="/contact/" class="text-link underline underline-offset-4">let us know</a> so we can fix it.
      </p>
    </div>
  </section>
</BaseLayout>
