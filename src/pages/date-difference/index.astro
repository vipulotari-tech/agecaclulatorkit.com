---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DateDifferenceCalculator from "../../components/DateDifferenceCalculator.astro";
import AdSlot from "../../components/AdSlot.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const title = "Date Difference Calculator – Calculate Time Between Two Dates";
const description = "Free date difference calculator to calculate time between two dates. Get years, months, days, total days between dates, weeks, hours and minutes — handles leap years and month lengths.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": "https://agecalculatorkit.com/date-difference/",
    "isPartOf": { "@type": "WebSite", "name": "Age Calculator", "url": "https://agecalculatorkit.com/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://agecalculatorkit.com/" },
      { "@type": "ListItem", "position": 2, "name": "Date Difference Calculator", "item": "https://agecalculatorkit.com/date-difference/" }
    ]
  }
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <section class="relative overflow-hidden border-b border-hairline bg-white">
    <div class="absolute inset-0 mesh-gradient opacity-40 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumbs items={[{label:"Home", href:"/"}, {label:"Date Difference"}]} />
      <div class="mx-auto max-w-[880px] mt-6">
        <h1 class="text-[30px] sm:text-[36px] font-semibold tracking-[-1.2px] leading-none text-ink">Date Difference Calculator</h1>
        <p class="mt-3 max-w-[640px] text-[16px] leading-6 text-body">This <strong class="font-medium text-ink">date difference calculator</strong> helps you <strong class="font-medium text-ink">calculate days between dates</strong> and get the exact <strong class="font-medium text-ink">date difference</strong> in years, months and days — plus total <strong class="font-medium text-ink">days between dates</strong>, weeks, hours, minutes and seconds. Pick any two dates to <strong class="font-medium text-ink">calculate days between dates</strong> with real month lengths. Order does not matter; the tool handles reversed dates automatically.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <DateDifferenceCalculator />

    <div class="mx-auto max-w-[880px] mt-8">
      <AdSlot height="120px" label="Advertisement — Date Difference below calculator" />
    </div>

    <article class="mx-auto max-w-[880px] mt-10 rounded-[16px] border border-hairline bg-white p-6 sm:p-8">
      <h2 class="text-lg font-semibold tracking-tight text-ink">How the difference is calculated</h2>
      <p class="mt-3 text-sm leading-6 text-body">This <strong class="font-medium text-ink">date calculator</strong> first determines which date is earlier. It then counts full years, then full months, then remaining days using the actual days in each month — the same calendar method used by the main <a href="/" class="text-link hover:text-link-deep underline underline-offset-4">age calculator</a> to <strong class="font-medium text-ink">calculate age</strong>. This avoids errors that come from assuming every month has 30 days or every year has 365 days, so you get a precise <strong class="font-medium text-ink">age difference calculator</strong> result for any span.</p>
      <h3 class="mt-6 text-sm font-semibold text-ink">Calendar vs. elapsed</h3>
      <p class="mt-2 text-sm leading-6 text-body">Calendar difference shows “1 year, 2 months, 5 days.” Elapsed values convert that span into total days and time (days × 24 = hours). Both are useful: calendar for human reading, elapsed for precise counting. See <a href="/how-it-works/" class="text-link hover:text-link-deep underline underline-offset-4">how age is calculated</a> for the exact rules, or use the <a href="/birthday-calculator/" class="text-link hover:text-link-deep underline underline-offset-4">birthday calculator</a> to see your next birthday countdown.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href="/" class="inline-flex items-center rounded-full bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-black transition">Age Calculator →</a>
        <a href="/birthday-calculator/" class="inline-flex items-center rounded-full border border-hairline bg-white px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft transition">Birthday Calculator →</a>
        <a href="/how-it-works/" class="text-sm text-link hover:text-link-deep underline underline-offset-4">Learn more about the method</a>
      </div>
    </article>
  </section>
</BaseLayout>
